# Puerto de la API
PORT=3000

# Clave para firmar los JWT (cámbiala en tu .env; nunca la subas al repositorio)
JWT_SECRET=cambia_esta_clave_secreta
JWT_EXPIRES_IN=8h

# Servicio SOAP EstrellaDeBelenService (usa la URL del mock del docente)
ESTRELLA_SOAP_URL=http://localhost:8088/estrella
# Revisa el WSDL del docente: si exige otro SOAPAction, cámbialo aquí
ESTRELLA_SOAP_ACTION=ConsultarRuta
ESTRELLA_TIMEOUT_MS=3000
# Intentos totales antes de declarar caído el servicio (máximo 2)
ESTRELLA_INTENTOS=2
ESTRELLA_BACKOFF_MS=300

# Puerto del mock SOAP local (solo para pruebas)
MOCK_PORT=8088
